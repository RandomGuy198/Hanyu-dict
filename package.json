{
  "name": "hanyu-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Free, offline-capable Chinese dictionary and learning PWA built from open-licensed data.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RandomGuy198/Hanyu-dict.git"
  },
  "homepage": "https://randomguy198.github.io/Hanyu-dict/",
  "bugs": {
    "url": "https://github.com/RandomGuy198/Hanyu-dict/issues"
  },
  "keywords": [
    "chinese",
    "mandarin",
    "dictionary",
    "cedict",
    "unihan",
    "pinyin",
    "stroke-order",
    "pwa",
    "offline",
    "github-pages"
  ],
  "scripts": {
    "dev": "vite",
    "build": "node scripts/content/check-provenance.mjs && node scripts/legal/check-public-tree.mjs && tsc -p tsconfig.json --noEmit && vitest run && vite build && node scripts/legal/check-public-tree.mjs",
    "build:only": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "data:fetch": "node scripts/content/fetch-sources.mjs",
    "data:build": "node scripts/content/build-all.mjs",
    "data:check": "node scripts/content/check-provenance.mjs",
    "licenses:runtime": "node scripts/collect-runtime-licenses.mjs",
    "licenses:runtime:check": "node scripts/collect-runtime-licenses.mjs --check",
    "legal:check": "node scripts/legal/check-public-tree.mjs",
    "icons": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "dexie": "^4.0.8",
    "dexie-react-hooks": "^1.1.7",
    "hanzi-writer": "^3.7.3",
    "pdfjs-dist": "^4.8.69",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "tesseract.js": "^5.1.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.49.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "fake-indexeddb": "^6.0.0",
    "globals": "^17.14.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.72.1",
    "unbzip2-stream": "^1.4.3",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^2.1.8"
  }
}
